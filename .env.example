# AURA — Environment Variables Template
#
# Live air-quality, weather and geocoding data come from the free
# Open-Meteo / CAMS APIs, which require NO API key and NO account.
# Nothing below is needed for live data.

# Server-side Gemini API key (free tier via Google AI Studio).
# Never exposed to the frontend/client bundle — used only by the
# serverless proxy in netlify/functions/gemini.js and api/gemini.js.
# Without it, AURA transparently uses its deterministic expert system.
GEMINI_API_KEY=<redacted>

# Optional: comma-separated extra origins allowed to call /api/gemini.
ALLOWED_ORIGINS=

# Optional: durable rate limiting for the Gemini proxy via Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
